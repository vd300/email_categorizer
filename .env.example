APP_NAME="AI Email Cleaner & Prioritizer"
ENVIRONMENT=local
DATABASE_URL=sqlite:///./email_cleaner.db

# Optional. If unset, the app uses transparent heuristic classification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required only for Gmail OAuth sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
GMAIL_SYNC_MAX_RESULTS=25

# Local OAuth callbacks use http://localhost. Keep this false in production.
ALLOW_INSECURE_OAUTH_TRANSPORT=true

# Use a long random string in production.
APP_SECRET_KEY=change-me-before-deploy
